		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/location/zona-aparcamiento/{entityid}";
			rr:termType rr:IRI
		];
	].


<parking-zone-geometry_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "2_parkinggroup_data_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
