		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintapar:ParkingZone;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:identifier;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "entityid";
