<parking-zone-has-spot_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "1_parkingspot__data_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/zona-aparcamiento/{refparkinggroup}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant edintapar:hasParkingSpot;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/plaza-aparcamiento/{entityid}";
			rr:termType rr:IRI
		];
	].


<offStreet-parking_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "3_offstreetparking_data_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/aparcamiento/{entityid}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant edintapar:OffStreetParking;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dct:identifier;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "entityid";
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdfs:label;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "Aparcamiento {name}";
			rr:termType rr:Literal
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant edintapar:numberOfParkingSpots;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "totalspotnumber";
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant edintapar:hasParkingZone;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://example.org/recurso/zona-aparcamiento/{refparkinggroup}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant edintapar:hasParkingSpot;
		];
		rr:objectMap [
			a rr:RefObjectMap;
			rr:parentTriplesMap <parking-spot_0>;
			rr:joinCondition [
				rr:child "refparkinggroup";
				rr:parent "refparkinggroup";
			];
		];
	].


